{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compile with g++",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                				
                "-g",
                "${file}",
                "${fileDirname}\\shared.cpp",
				"${workspaceFolder}\\common\\aoccom.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-I",
				"${workspaceFolder}\\common"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Default build configuration"
        },
        {
            "type": "cppbuild",
            "label": "Compile with g++ (no shared code)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                				
                "-g",
                "${file}",
				"${workspaceFolder}\\common\\aoccom.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-I",
				"${workspaceFolder}\\common"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
            },
            "detail": "For some days without shared code"
        }
    ],
    "version": "2.0.0"
}